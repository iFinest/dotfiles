[{
	"output": ["DP-1"],

	"mode": "dock",
	"position": "bottom",
	"layer": "top",
	"width": 0,
	"height": 0,
	"margin": 0,
	"spacing": 0,
	"reload_style_on_change": true,

	"include": [
		"~/.config/waybar/modules/custom/*.jsonc",
		"~/.config/waybar/modules/sway/*.jsonc",
        "~/.config/waybar/modules/group/*.jsonc",
		"~/.config/waybar/modules/*.jsonc"
	],

	"modules-left": [
        "sway/mode",
		"sway/workspaces",
		"custom/separator#text",

		"sway/window"
	],
	"modules-center": [],
	"modules-right": [
        "group/tray-expander",

        "clock#time",

        "custom/separator#text",

		"idle_inhibitor",
		"custom/power"
	]
},
{
	"output": ["HDMI-A-1"],

	"mode": "dock",
	"position": "bottom",
	"layer": "top",
	"width": 0,
	"height": 0,
	"margin": 0,
	"spacing": 0,
	"reload_style_on_change": true,

	"include": [
		"~/.config/waybar/modules/custom/*.jsonc",
		"~/.config/waybar/modules/hyprland/*.jsonc",
		"~/.config/waybar/modules/*.jsonc"
	],

	"modules-left": [
		"sway/workspaces",
		"custom/separator#text",
		"sway/window"
	],

	"modules-center": [],

	"modules-right": [
		"custom/mpris",
		"custom/separator#text",
		"group/pulseaudio"
	]
}]
