#!/usr/bin/env bash

AMD_SMI="/opt/rocm/bin/amd-smi"

main() {
	local option="$1"
	local metrics

	metrics=$("$AMD_SMI" metric -g 0 -u -m -t --json) || exit 1

	case "$option" in
	usage)
		jq -r '.gpu_data[0].usage.gfx_activity.value' <<<"$metrics"
		;;

	vram)
		jq -c '
                .gpu_data[0].mem_usage |
                (.used_vram.value / 1024) as $used |
                (.total_vram.value / 1024) as $total |
                {
                    text: "\(($used * 10 | round) / 10)G",
                    used: (($used * 10 | round) / 10),
                    total: (($total * 10 | round) / 10),
                    percentage: ((.used_vram.value / .total_vram.value * 100) | round)
                }
            ' <<<"$metrics"
		;;

	temperature)
		local temperature
		temperature=$(jq -r '.gpu_data[0].temperature.edge.value' <<<"$metrics")

		if ((temperature >= 70)); then
			printf '{"text":"%s","class":"critical"}\n' "$temperature"
		else
			printf '{"text":"%s"}\n' "$temperature"
		fi
		;;

	*)
		printf "Usage: gpu usage|vram|temperature\n"
		exit 1
		;;
	esac
}

main "$@"
