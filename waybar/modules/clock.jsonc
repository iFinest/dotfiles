{
	"clock#time": {
		"format": "{:%H:%M}",
		"interval": 60,
		"min-length": 5,
		"max-length": 5,
		"tooltip-format": "{:%H:%M}"
	},

	"clock#date": {
		"format": "{:%d-%m}",
		"min-length": 8,
		"max-length": 8,
		"actions": {
			"on-click": "mode"
		},

		"calendar": {
			"mode": "month",
			"mode-mon-col": 3,
			"format": {
				"months": "<span alpha='100%'>{}</span>",
				"days": "<span alpha='85%'>{}</span>",
				"weekdays": "<span alpha='60%'><i>{}</i></span>",
				"today": "<span alpha='100%'><u>{}</u></span>"
			}
		},

		"tooltip-format": "{calendar}"
	}
}
