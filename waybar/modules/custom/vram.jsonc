{
    "custom/vram": {
        "exec": "~/.config/waybar/scripts/gpu vram",
        "interval": 10,
        "return-type": "json",
        "format": "󰘚 {text}",
        "states": {
            "warning": 75,
            "critical": 90
        },
        "format-warning": "󰘚 {text}",
        "format-critical": "󰀨 {text}",
        "min-length": 8,
        "max-length": 8,
        "tooltip-format": "Video Memory Used:\n{percentage}%"
    }
}